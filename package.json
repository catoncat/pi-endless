{
	"name": "pi-endless",
	"version": "0.1.0",
	"description": "One chat that never ends, for pi: the chat itself is the memory (Taelin's OptChat/UniiChat recipe). Opt-in per conversation; zoom, search and date tools; nothing is ever lost.",
	"type": "module",
	"license": "MIT",
	"author": "catoncat",
	"repository": { "type": "git", "url": "git+https://github.com/catoncat/pi-endless.git" },
	"homepage": "https://github.com/catoncat/pi-endless#readme",
	"bugs": { "url": "https://github.com/catoncat/pi-endless/issues" },
	"keywords": ["pi-package", "pi-extension", "memory", "optchat", "endless-chat"],
	"pi": { "extensions": ["./src/index.ts"] },
	"files": ["src", "docs", "scripts", "README.md", "LICENSE", "AGENTS.md"],
	"scripts": {
		"check": "tsc --noEmit -p tsconfig.json",
		"test": "bun test",
		"check-recipe": "node scripts/check-recipe.mjs"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "1.0.4",
		"@earendil-works/pi-coding-agent": "1.0.4",
		"@earendil-works/pi-tui": "1.0.4",
		"@types/node": "^24.0.0",
		"typebox": "1.3.27",
		"typescript": "^5.9.0"
	},
	"engines": { "node": ">=22" }
}
